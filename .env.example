# Almond AI Environment Configuration

# Application Environment
ENVIRONMENT=development
PORT=8000

# Pricing (One-time or monthly unlocked rate)
ALMOND_PRICE_INR=699
ALMOND_PRICE_USD=19

# Supabase Credentials (Authentication & PostgreSQL Database)
# Get these from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Razorpay Credentials (Indian Domestic UPI, RuPay, NetBanking)
# Get these from: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Stripe Credentials (Global Credit Cards & Foreign Payments) [Optional Phase 2]
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
